# test_biblioteca_virtual_colores.py
import time
from datetime import datetime
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas
from reportlab.lib import colors

# =========================
# CONFIGURACIÓN
# =========================
URL_LOGIN = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/login"
URL_DASHBOARD = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin"
URL_LIBROS = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin/gestion/libros/fisicos"
URL_PRESTAMOS = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin/gestion/prestamos"

ADMIN_EMAIL = "admin@cubo.com"
ADMIN_PASSWORD = "admin2025"

REPORT_FILE = "reporte_pruebas_BibliotecaVirtual.pdf"

# =========================
# UTILIDADES DE REPORTE
# =========================
results = []

# Colores ANSI para terminal
GREEN = "\033[92m"
RED = "\033[91m"
GRAY = "\033[90m"
RESET = "\033[0m"

def colored_bar(status):
    if status == "OK":
        return f"{GREEN}████████████████{RESET}"
    elif status == "FAIL":
        return f"{RED}████████████████{RESET}"
    else:
        return f"{GRAY}████████████████{RESET}"

def add_result(t_type, name, status, detail=""):
    results.append({
        "type": t_type,
        "name": name,
        "status": status,
        "detail": detail,
        "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    })
    bar = colored_bar(status)
    print(f"{bar} {status:<5} | {t_type:<12} | {name}")

# =========================
# DRIVER
# =========================
def start_driver(headless=False):
    opts = Options()
    if headless:
        opts.add_argument("--headless=new")
    opts.add_argument("--start-maximized")
    opts.add_argument("--disable-blink-features=AutomationControlled")
    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=opts)
    driver.set_page_load_timeout(30)
    return driver

# =========================
# PRUEBAS
# =========================
def pruebas_unitarias(driver, wait):
    t = "UNITARIA"
    try:
        driver.get(URL_LOGIN)
        wait.until(EC.presence_of_element_located((By.NAME, "email")))
        add_result(t, "Campo 'email' visible", "OK")
    except Exception as e:
        add_result(t, "Campo 'email' visible", "FAIL", str(e))

    try:
        if driver.find_element(By.NAME, "password"):
            add_result(t, "Campo 'password' visible", "OK")
    except Exception as e:
        add_result(t, "Campo 'password' visible", "FAIL", str(e))

    try:
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']")
        add_result(t, "Botón submit/login presente", "OK")
    except Exception as e:
        add_result(t, "Botón submit/login presente", "FAIL", str(e))

def pruebas_integracion(driver, wait):
    t = "INTEGRACIÓN"
    try:
        driver.get(URL_LOGIN)
        wait.until(EC.presence_of_element_located((By.NAME, "email")))
        driver.find_element(By.NAME, "email").send_keys(ADMIN_EMAIL)
        driver.find_element(By.NAME, "password").send_keys(ADMIN_PASSWORD)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        time.sleep(3)
        if any(k in driver.page_source for k in ["Dashboard", "Panel", "Bienvenido", "Administrador"]):
            add_result(t, "Login y redirección al dashboard", "OK")
        else:
            add_result(t, "Login y redirección al dashboard", "FAIL", "No redirigió correctamente")
    except Exception as e:
        add_result(t, "Login y redirección al dashboard", "FAIL", str(e))

def pruebas_funcionales_libros(driver, wait):
    t = "FUNCIONAL"
    try:
        driver.get(URL_LIBROS)
        wait.until(EC.presence_of_element_located((By.CLASS_NAME, "content-section")))
        add_result(t, "Carga página 'Gestión de Libros Físicos'", "OK")
    except Exception as e:
        add_result(t, "Carga página 'Gestión de Libros Físicos'", "FAIL", str(e))
        return

    botones = {
        "Agregar libro": (By.CSS_SELECTOR, ".btn-add"),
        "Editar libro": (By.CSS_SELECTOR, ".btn-edit"),
        "Ver libro": (By.CSS_SELECTOR, ".btn-view"),
        "Eliminar libro": (By.CSS_SELECTOR, ".btn-delete")
    }

    for nombre, locator in botones.items():
        try:
            elems = driver.find_elements(*locator)
            if not elems:
                add_result(t, nombre, "SKIP", "Botón no encontrado")
                continue
            driver.execute_script("arguments[0].click();", elems[0])
            time.sleep(1)
            add_result(t, nombre, "OK")
        except Exception as e:
            add_result(t, nombre, "FAIL", str(e))

def pruebas_funcionales_prestamos(driver, wait):
    t = "FUNCIONAL"
    try:
        driver.get(URL_PRESTAMOS)
        wait.until(EC.presence_of_element_located((By.CLASS_NAME, "content-section")))
        add_result(t, "Carga página 'Gestión de Préstamos'", "OK")
    except Exception as e:
        add_result(t, "Carga página 'Gestión de Préstamos'", "FAIL", str(e))
        return

    try:
        filtros = driver.find_elements(By.CSS_SELECTOR, ".filter-buttons .filter-btn")
        if filtros:
            for f in filtros:
                driver.execute_script("arguments[0].click();", f)
                time.sleep(0.5)
            add_result(t, "Filtros de préstamos funcionales", "OK")
        else:
            add_result(t, "Filtros de préstamos funcionales", "SKIP", "No hay filtros")
    except Exception as e:
        add_result(t, "Filtros de préstamos funcionales", "FAIL", str(e))

def pruebas_usabilidad(driver, wait):
    t = "USABILIDAD"
    try:
        driver.get(URL_LIBROS)
        driver.get(URL_PRESTAMOS)
        add_result(t, "Navegación entre módulos (Libros → Préstamos)", "OK")
    except Exception as e:
        add_result(t, "Navegación entre módulos", "FAIL", str(e))

# =========================
# GENERAR PDF
# =========================
def generar_pdf(filename=REPORT_FILE):
    c = canvas.Canvas(filename, pagesize=letter)
    c.setTitle("Reporte de Pruebas - Biblioteca Virtual CUBO")

    c.setFont("Helvetica-Bold", 16)
    c.drawString(150, 760, "Reporte de Pruebas - Biblioteca Virtual CUBO")
    c.setFont("Helvetica", 10)
    c.drawString(50, 740, f"Fecha de ejecución: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")

    y = 710
    for r in results:
        if r["status"] == "OK":
            c.setFillColor(colors.green)
        elif r["status"] == "FAIL":
            c.setFillColor(colors.red)
        else:
            c.setFillColor(colors.grey)

        c.rect(50, y-5, 15, 10, fill=True, stroke=False)
        c.setFillColor(colors.black)
        c.drawString(70, y, f"[{r['status']}] {r['type']} - {r['name']}")
        y -= 15
        if y < 60:
            c.showPage()
            y = 750
    c.save()
    print(f"\n📄 Reporte PDF generado: {filename}")

# =========================
# MAIN
# =========================
def main():
    driver = None
    try:
        driver = start_driver(headless=False)
        wait = WebDriverWait(driver, 10)

        pruebas_unitarias(driver, wait)
        pruebas_integracion(driver, wait)
        pruebas_funcionales_libros(driver, wait)
        pruebas_funcionales_prestamos(driver, wait)
        pruebas_usabilidad(driver, wait)

    except Exception as e:
        print("ups Error general:", e)
    finally:
        if driver:
            driver.quit()
        generar_pdf(REPORT_FILE)

if __name__ == "__main__":
    main()
