# test_biblioteca_virtual.py
import time
from datetime import datetime
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas

# =========================
# CONFIGURACIÓN (AJUSTAR)
# =========================
URL_LOGIN = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/login"
URL_DASHBOARD = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin"
URL_LIBROS = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin/gestion/libros/fisicos"
URL_PRESTAMOS = "https://biblioteca-cubo.com/Biblioteca-CUBO/public/admin/gestion/prestamos"

ADMIN_EMAIL = "admin@cubo.com"
ADMIN_PASSWORD = "admin2025"

REPORT_FILE = "reporte_pruebas_BibliotecaVirtual.pdf"

# =========================
# UTILIDADES DE REPORTE
# =========================
results = []  # cada item: dict {type, name, status, detail, time}

def add_result(t_type, name, status, detail=""):
    results.append({
        "type": t_type,
        "name": name,
        "status": status,   # "OK", "FAIL", "SKIP"
        "detail": detail,
        "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    })
    icon = "✔️" if status == "OK" else ("❌" if status == "FAIL" else "➖")
    print(f"[{icon}] {t_type} - {name} {('- ' + detail) if detail else ''}")

# =========================
# INICIALIZAR DRIVER
# =========================
def start_driver(headless=False):
    opts = Options()
    if headless:
        opts.add_argument("--headless=new")
    opts.add_argument("--start-maximized")
    opts.add_argument("--disable-blink-features=AutomationControlled")
    opts.add_argument("--no-sandbox")
    opts.add_argument("--disable-dev-shm-usage")
    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=opts)
    driver.set_page_load_timeout(30)
    return driver

# =========================
# PRUEBAS UNITARIAS (INTERFAZ)
# =========================
def pruebas_unitarias(driver, wait):
    t = "UNITARIA"
    try:
        driver.get(URL_LOGIN)
        wait.until(EC.presence_of_element_located((By.NAME, "email")))
        add_result(t, "Campo 'email' visible", "OK")
    except Exception as e:
        add_result(t, "Campo 'email' visible", "FAIL", str(e))

    try:
        if driver.find_element(By.NAME, "password"):
            add_result(t, "Campo 'password' visible", "OK")
    except Exception as e:
        add_result(t, "Campo 'password' visible", "FAIL", str(e))

    try:
        submit = driver.find_element(By.CSS_SELECTOR, "button[type='submit']")
        add_result(t, "Botón submit/login presente", "OK")
    except Exception as e:
        add_result(t, "Botón submit/login presente", "FAIL", str(e))

# =========================
# PRUEBAS DE INTEGRACIÓN (LOGIN + REDIRECCIÓN)
# =========================
def pruebas_integracion(driver, wait):
    t = "INTEGRACIÓN"
    try:
        driver.get(URL_LOGIN)
        wait.until(EC.presence_of_element_located((By.NAME, "email")))
        driver.find_element(By.NAME, "email").clear()
        driver.find_element(By.NAME, "email").send_keys(ADMIN_EMAIL)
        driver.find_element(By.NAME, "password").clear()
        driver.find_element(By.NAME, "password").send_keys(ADMIN_PASSWORD)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        # esperar redirección al dashboard
        try:
            wait.until(EC.url_contains(URL_DASHBOARD))
            add_result(t, "Login y redirección al dashboard", "OK")
        except:
            # alternativa: buscar texto de bienvenida
            time.sleep(2)
            page = driver.page_source
            if any(k in page for k in ["Dashboard", "Panel", "Bienvenido", "Administrador"]):
                add_result(t, "Login (contenido dashboard detectado)", "OK")
            else:
                add_result(t, "Login y redirección al dashboard", "FAIL", "No redirigió ni encontró texto esperado")
    except Exception as e:
        add_result(t, "Login y redirección al dashboard", "FAIL", str(e))

# =========================
# PRUEBAS FUNCIONALES (CRUD botones libros)
# =========================
def pruebas_funcionales_libros(driver, wait):
    t = "FUNCIONAL"
    try:
        driver.get(URL_LIBROS)
        wait.until(EC.presence_of_element_located((By.CLASS_NAME, "content-section")))
        add_result(t, "Carga página 'Gestión de Libros Físicos'", "OK")
    except Exception as e:
        add_result(t, "Carga página 'Gestión de Libros Físicos'", "FAIL", str(e))
        return

    # Intentar detectar campo de búsqueda (si existe)
    try:
        search = driver.find_element(By.ID, "buscarLibro")
        add_result(t, "Campo búsqueda libros (id=buscarLibro)", "OK")
    except:
        add_result(t, "Campo búsqueda libros (id=buscarLibro)", "SKIP", "No existe en interfaz")

    # Probar filtros (si existen)
    try:
        filtros = driver.find_elements(By.CSS_SELECTOR, ".filter-buttons .filter-btn")
        if len(filtros) >= 1:
            for idx, f in enumerate(filtros):
                try:
                    driver.execute_script("arguments[0].scrollIntoView(true);", f)
                    driver.execute_script("arguments[0].click();", f)
                    time.sleep(0.7)
                    add_result(t, f"Filtro libros #{idx+1} clickable", "OK")
                except Exception as fe:
                    add_result(t, f"Filtro libros #{idx+1} clickable", "FAIL", str(fe))
        else:
            add_result(t, "Filtros libros", "SKIP", "No hay botones de filtro")
    except Exception as e:
        add_result(t, "Filtros libros", "FAIL", str(e))

    # Botones CRUD: usar selectores proporcionados (clases/ids)
    botones = {
        "Agregar libro": (By.CSS_SELECTOR, ".btn-add, #btn-add"),
        "Editar libro": (By.CSS_SELECTOR, ".btn-edit, #btn-edit"),
        "Ver libro": (By.CSS_SELECTOR, ".btn-view, #btn-view"),
        "Eliminar libro": (By.CSS_SELECTOR, ".btn-delete, #btn-delete")
    }

    for nombre, locator in botones.items():
        try:
            # locator es (By.CSS_SELECTOR, selector)
            by, sel = locator
            elems = driver.find_elements(by, sel)
            if not elems:
                add_result(t, nombre, "SKIP", "Botón no encontrado")
                continue
            # Si hay varios, tomamos el primero visible
            clicked = False
            for e in elems:
                try:
                    driver.execute_script("arguments[0].scrollIntoView(true);", e)
                    # intentar click seguro
                    driver.execute_script("arguments[0].click();", e)
                    time.sleep(1.2)
                    add_result(t, nombre, "OK")
                    # si se abrió modal o página nueva, intentar cerrarlo o regresar
                    # cerrar modal si aparece (buscamos .modal .btn-close o button[data-bs-dismiss='modal'])
                    try:
                        close_btn = driver.find_elements(By.CSS_SELECTOR, ".modal .btn-close, button[data-bs-dismiss='modal'], .modal .close")
                        if close_btn:
                            driver.execute_script("arguments[0].click();", close_btn[0])
                            time.sleep(0.6)
                    except:
                        pass
                    try:
                        driver.back()
                        time.sleep(0.6)
                    except:
                        pass
                    clicked = True
                    break
                except Exception as click_ex:
                    # probar siguiente elemento si hay
                    continue
            if not clicked:
                add_result(t, nombre, "FAIL", "No fue posible hacer click en ningún elemento")
        except Exception as e:
            add_result(t, nombre, "FAIL", str(e))

# =========================
# PRUEBAS FUNCIONALES (Prestamos)
# =========================
def pruebas_funcionales_prestamos(driver, wait):
    t = "FUNCIONAL"
    try:
        driver.get(URL_PRESTAMOS)
        wait.until(EC.presence_of_element_located((By.CLASS_NAME, "content-section")))
        add_result(t, "Carga página 'Gestión de Préstamos'", "OK")
    except Exception as e:
        add_result(t, "Carga página 'Gestión de Préstamos'", "FAIL", str(e))
        return

    # búsqueda por input dentro de .search-bar
    try:
        s = driver.find_element(By.CSS_SELECTOR, ".search-bar input, input[name='search']")
        s.clear()
        s.send_keys("Carlos")
        s.send_keys(Keys.RETURN)
        time.sleep(1.2)
        add_result(t, "Búsqueda préstamos por usuario", "OK")
    except Exception as e:
        add_result(t, "Búsqueda préstamos por usuario", "SKIP", "Campo búsqueda no encontrado o no interactivo")

    # filtros prestamos
    try:
        filtros = driver.find_elements(By.CSS_SELECTOR, ".filter-buttons .filter-btn")
        if filtros:
            for i, f in enumerate(filtros):
                try:
                    driver.execute_script("arguments[0].click();", f)
                    time.sleep(0.8)
                    add_result(t, f"Filtro préstamos #{i+1} clickable", "OK")
                except Exception as fe:
                    add_result(t, f"Filtro préstamos #{i+1} clickable", "FAIL", str(fe))
        else:
            add_result(t, "Filtros préstamos", "SKIP", "No hay botones de filtro")
    except Exception as e:
        add_result(t, "Filtros préstamos", "FAIL", str(e))

# =========================
# USABILIDAD (navegación, textos, tiempos)
# =========================
def pruebas_usabilidad(driver, wait):
    t = "USABILIDAD"
    try:
        # comprobar acceso rápido entre módulos
        driver.get(URL_DASHBOARD)
        time.sleep(1)
        # intentar navegar a libros y luego a prestamos
        driver.get(URL_LIBROS); time.sleep(0.8)
        driver.get(URL_PRESTAMOS); time.sleep(0.8)
        add_result(t, "Navegación entre módulos principal -> libros -> prestamos", "OK")
    except Exception as e:
        add_result(t, "Navegación entre módulos", "FAIL", str(e))

    # revisar presencia de texto clave en páginas
    try:
        driver.get(URL_LIBROS); time.sleep(0.8)
        page = driver.page_source
        if "Catálogo de Libros" in page or "Libros" in page:
            add_result(t, "Texto 'Catálogo de Libros' visible", "OK")
        else:
            add_result(t, "Texto 'Catálogo de Libros' visible", "SKIP", "Texto no detectado")
    except Exception as e:
        add_result(t, "Texto 'Catálogo de Libros' visible", "FAIL", str(e))

# =========================
# GENERAR REPORTE PDF
# =========================
def generar_pdf(filename=REPORT_FILE):
    c = canvas.Canvas(filename, pagesize=letter)
    c.setTitle("Reporte de Pruebas - Biblioteca Virtual CUBO")
    c.setFont("Helvetica-Bold", 14)
    c.drawString(160, 760, "Reporte de Pruebas - Biblioteca Virtual CUBO")
    c.setFont("Helvetica", 10)
    c.drawString(50, 740, f"Fecha ejecución: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    y = 715

    # Agrupar por type
    types = ["UNITARIA", "INTEGRACIÓN", "FUNCIONAL", "USABILIDAD"]
    for t in types:
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, f"{t}")
        y -= 18
        c.setFont("Helvetica", 9)
        for r in [x for x in results if x["type"] == t]:
            line = f"{'✔️' if r['status']=='OK' else ('❌' if r['status']=='FAIL' else '➖')} {r['name']} - {r['status']}"
            if r["detail"]:
                line += f" ({r['detail']})"
            c.drawString(55, y, line)
            y -= 14
            if y < 60:
                c.showPage()
                y = 750
        y -= 8

    # listar restantes no agrupados
    c.setFont("Helvetica", 9)
    c.save()
    print(f"\n📄 Reporte generado: {filename}")

# =========================
# RUN
# =========================
def main():
    driver = None
    try:
        driver = start_driver(headless=False)   # headless=True para CI
        wait = WebDriverWait(driver, 12)

        # Unitarias (interfaz)
        pruebas_unitarias(driver, wait)

        # Integración (login + dashboard)
        pruebas_integracion(driver, wait)

        # Funcionales - Libros (CRUD/buttons)
        pruebas_funcionales_libros(driver, wait)

        # Funcionales - Prestamos
        pruebas_funcionales_prestamos(driver, wait)

        # Usabilidad
        pruebas_usabilidad(driver, wait)

    except Exception as e:
        print("Error general en ejecución:", e)
    finally:
        if driver:
            driver.quit()
        generar_pdf(REPORT_FILE)

if __name__ == "__main__":
    main()
